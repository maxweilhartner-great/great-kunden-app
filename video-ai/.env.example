# Kopieren nach .env und ausfüllen. Leere Plattform-Zugangsdaten = Plattform in der App „noch nicht eingerichtet“.

# --- Server ---
PORT=3000
# Öffentliche Adresse der App (wichtig für die OAuth-Weiterleitungen, muss https sein für Meta/TikTok/LinkedIn)
PUBLIC_BASE_URL=https://video.great-betriebsverpflegung.at
# Langer Zufallswert, z. B.: openssl rand -hex 32
SESSION_SECRET=
# Team-Passwort: darf hochladen und die Liste ansehen (Fahrer, Techniker …)
TEAM_PASSWORD=
# Admin-Passwort: darf freigeben, Änderungen verlangen und Konten verknüpfen
ADMIN_PASSWORD=
MAX_UPLOAD_MB=2048

# --- Video ---
# Whisper-Modell: tiny | base | small | medium | large-v3  (small = guter Kompromiss auf CPU)
WHISPER_MODEL=small
WHISPER_LANGUAGE=de
# LOGO_FILE=brand/logo.png
# OUTRO_FILE=brand/logo-outro.png
# Abspann mit Logo + Slogan am Ende (Sekunden, 0 = aus)
OUTRO_SECONDS=2.5
# MUSIC_DIR=brand/music
# SUBTITLE_FONT=Inter

# --- Meta (Instagram + Facebook) — https://developers.facebook.com/apps ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# --- LinkedIn — https://www.linkedin.com/developers/apps ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: ID der Unternehmensseite (nur mit freigeschalteter Community Management API)
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_VERSION=202509

# --- YouTube (Google Cloud Console, YouTube Data API v3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# public | unlisted | private
YOUTUBE_PRIVACY=public

# --- TikTok — https://developers.tiktok.com (Content Posting API, Direct Post) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Bis TikTok die App geprüft hat, ist nur SELF_ONLY (privat) erlaubt. Danach: PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY
